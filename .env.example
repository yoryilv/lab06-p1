# ==============================================================================
# Variables de entorno - Administración de Usuarios Cloud (EC2 + RDS + S3)
# Copia este archivo a .env y completa los valores reales antes de desplegar.
# ==============================================================================

# Base de datos PostgreSQL (Amazon RDS en producción o contenedor local)
# Formato RDS: postgresql://usuario:password@tu-rds-endpoint.rds.amazonaws.com:5432/users_db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/users_db

# Región AWS y bucket privado de Amazon S3 para avatares
AWS_REGION=us-east-1
S3_BUCKET_NAME=tu-bucket-privado-avatars

# Credenciales AWS (OPCIONALES en EC2 con IAM Role).
# - En EC2 con IAM Role adjunto: deja estas tres variables vacías para usar Instance Profile automáticamente.
# - En desarrollo local o AWS Academy con credenciales temporales: complétalas.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Credenciales del administrador de la aplicación web
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CambiaEstaPasswordSegura123!

# Clave secreta para firmar cookies de sesión (genera una cadena aleatoria larga)
# Ejemplo: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-64-caracteres

